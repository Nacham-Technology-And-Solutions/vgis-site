  "components": [
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Pill-shaped buttons; the orange primary is the one action you most want taken on a view."
    },
    {
      "name": "FeatureBar",
      "group": "Content",
      "summary": "A full-width row (icon circle, title, one-line description) for feature lists, from the deck's Key Features slide."
    },
    {
      "name": "FeatureCard",
      "group": "Content",
      "summary": "The signature Skyframe card: White surface, 1.5px Ink outline, radius-lg corners, a PillLabel overlapping the top edge."
    },
    {
      "name": "HalftonePanel",
      "group": "Graphics",
      "summary": "A panel whose background is a grid of Ink dots fading out from one edge: the cover-page motif, a plan dissolving into reality."
    },
    {
      "name": "HighlightHeadline",
      "group": "Typography",
      "summary": "A Montserrat ExtraBold headline with one word or phrase on a Frame Orange bar, from the deck cover (\"Pitch Deck Presentation\")."
    },
    {
      "name": "PillLabel",
      "group": "Labels",
      "summary": "Rounded orange tag that names a card, a tier or a section, taken from the pitch deck."
    },
    {
      "name": "PropertyCodeField",
      "group": "App",
      "summary": "The code-entry panel from the Quest app and the website: where a buyer types the Property Code a developer gave them."
    },
    {
      "name": "StepMarker",
      "group": "Content",
      "summary": "Numbered circle plus tracked-caps title and a short line, for \"From Blueprint to VR in Three Simple Steps\" and other sequences."
    }
  ],
