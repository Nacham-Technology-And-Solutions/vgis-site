# Copy to .env.local for local dev. In production, set these in Vercel → Project → Settings → Environment Variables.

# Canonical origin. Leave as the production domain even on previews (previews are noindexed by robots.ts).
NEXT_PUBLIC_SITE_URL=https://3dvgis.com

# Contact form (Resend). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=3d.vgis.ltd@gmail.com
CONTACT_FROM_EMAIL="VGIS Website <web@3dvgis.com>"

# Search console ownership (optional; the token value only, not the full meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Ad conversion tracking (optional; nothing loads unless set). Leads fire on WhatsApp click and form submit.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=            # e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=    # conversion label for the "Lead" action
NEXT_PUBLIC_GA4_ID=                   # e.g. G-XXXXXXXXXX

# Where clients' replies to the auto-reply go (defaults to the site's main email)
CONTACT_REPLY_TO=
